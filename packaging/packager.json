{
  "productName": "Live Linguist",
  "version": "0.1.0",
  "identifier": "com.livelinguist.pc",
  "binariesDir": "../dist/windows",
  "outDir": "../dist/bundle",
  "binaries": [
    { "path": "livelinguist.exe", "main": true },
    { "path": "livelinguist-core.node", "main": false }
  ],
  "resources": ["assets", "backends", "licenses"],
  "formats": ["nsis"],
  "windows": {
    "nsis": {
      "installMode": "currentUser",
      "languages": ["English"],
      "displayLanguageSelector": false
    }
  }
}
