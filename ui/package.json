{
  "name": "livelinguist-pc-ui",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "module": "src/main.tsx",
  "type": "module",
  "scripts": {
    "start": "bun --hot src/main.tsx",
    "dev": "bun --hot src/main.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check src scripts",
    "format": "biome format --write src scripts",
    "screenshots": "bun run scripts/screenshots.ts",
    "screenshots:windows": "bun run scripts/screenshots-windows.tsx"
  },
  "dependencies": {
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
