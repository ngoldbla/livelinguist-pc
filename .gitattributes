# Keep text files LF on every platform. A CRLF checkout breaks Biome (and the
# formatters) on Windows even though the committed content is correct.
* text=auto eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.gguf binary
*.onnx binary
*.node binary
*.zip binary
*.exe binary
*.dll binary
